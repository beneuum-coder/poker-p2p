{
  "name": "poker-p2p",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Pages 轻量联机德州扑克（PeerJS + texas-poker-core，房主权威）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/unit",
    "test:e2e": "node scripts/build.mjs && node test/e2e/run-e2e.mjs",
    "verify": "npm test && npm run test:e2e",
    "serve": "node test/helpers/serve.mjs docs 8080"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "texas-poker-core": "1.4.35"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
